# Browser/iOS simulator on the backend computer:
EXPO_PUBLIC_API_URL=http://localhost:5257
# Android emulator: http://10.0.2.2:5257
# Physical device: use the backend computer's LAN IP and bind the backend to 0.0.0.0.
# This setting is public and must not contain secrets.
