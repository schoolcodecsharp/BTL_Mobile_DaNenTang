{
  "name": "be-btl-mobile",
  "version": "1.0.0",
  "description": "Backend API cho ứng dụng To-Do List",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "test": "node --test tests/*.test.js",
    "db:create": "sequelize-cli db:create",
    "db:check": "node scripts/check-migrations.js",
    "db:migrate": "sequelize-cli db:migrate",
    "db:status": "sequelize-cli db:migrate:status",
    "db:undo": "sequelize-cli db:migrate:undo",
    "db:migration:create": "sequelize-cli migration:generate"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "multer": "^2.4.0",
    "mysql2": "^3.12.0",
    "sequelize": "^6.37.5",
    "swagger-jsdoc": "6.2.8",
    "swagger-ui-express": "5.0.1",
    "uuid": "^14.0.2"
  },
  "devDependencies": {
    "nodemon": "^3.1.9",
    "sequelize-cli": "^6.6.5"
  },
  "private": true
}
