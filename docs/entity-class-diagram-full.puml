@startuml
title Biểu đồ lớp thực thể - To-Do List
left to right direction
skinparam classAttributeIconSize 0
skinparam linetype ortho

class NguoiDung <<entity>> {
  table: nguoi_dung
  --
  +id: INTEGER <<PK, NOT NULL>>
  +ten_dang_nhap: STRING(50) <<UNIQUE, NOT NULL>>
  +email: STRING(100) <<UNIQUE, NOT NULL>>
  +mat_khau: STRING(255) <<NOT NULL>>
  +ho_ten: STRING(100)
  +anh_dai_dien: STRING(255)
  +ngay_tao: DATE
  +trang_thai: BOOLEAN
  --
  +{static} dangKy(thongTin): NguoiDung
  +{static} dangNhap(email, matKhau): PhienDangNhap
  +capNhatHoSo(thongTin): void
  +doiMatKhau(matKhauCu, matKhauMoi): void
}

class DanhMuc <<entity>> {
  table: danh_muc
  --
  +id: INTEGER <<PK, NOT NULL>>
  +nguoi_dung_id: INTEGER <<FK, NOT NULL>>
  +ten_danh_muc: STRING(100) <<NOT NULL>>
  +mo_ta: STRING(255)
  +mau_sac: STRING(20)
  --
  +{static} tao(thongTin): DanhMuc
  +capNhat(thongTin): void
  +xoa(): void
}

class CongViec <<entity>> {
  table: cong_viec
  --
  +id: INTEGER <<PK, NOT NULL>>
  +nguoi_dung_id: INTEGER <<FK, NOT NULL>>
  +danh_muc_id: INTEGER <<FK>>
  +tieu_de: STRING(200) <<NOT NULL>>
  +mo_ta: TEXT
  +muc_do_uu_tien: STRING(20)
  +trang_thai: STRING(20)
  +ngay_bat_dau: DATE
  +han_hoan_thanh: DATE
  +ngay_hoan_thanh: DATE
  +ngay_tao: DATE
  +ngay_cap_nhat: DATE
  +file_dinh_kem: TEXT
  +lap_lai: STRING(20) <<NOT NULL>>
  +da_tao_lan_tiep: BOOLEAN <<NOT NULL>>
  +ngay_xoa: DATE
  --
  +{static} tao(thongTin): CongViec
  +capNhat(thongTin): void
  +chuyenVaoThungRac(): void
  +khoiPhuc(): void
  +xoaVinhVien(): void
}

class NhacNho <<entity>> {
  table: nhac_nho
  --
  +id: INTEGER <<PK, NOT NULL>>
  +cong_viec_id: INTEGER <<FK, NOT NULL>>
  +thoi_gian_nhac: DATE <<NOT NULL>>
  +loai_nhac: STRING(20)
  +da_gui: BOOLEAN
  --
  +{static} tao(thongTin): NhacNho
  +capNhat(thongTin): void
  +xoa(): void
}

class ThongBao <<entity>> {
  table: thong_bao
  --
  +id: INTEGER <<PK, NOT NULL>>
  +nguoi_dung_id: INTEGER <<FK, NOT NULL>>
  +cong_viec_id: INTEGER <<FK>>
  +tieu_de: STRING(200) <<NOT NULL>>
  +noi_dung: TEXT
  +da_doc: BOOLEAN
  +ngay_tao: DATE
  +nhom_id: INTEGER <<FK>>
  +cong_viec_nhom_id: INTEGER <<FK>>
  +loai: STRING(30) <<NOT NULL>>
  --
  +{static} tao(thongTin): ThongBao
  +danhDauDaDoc(): void
  +xoa(): void
}

class LichSuCongViec <<entity>> {
  table: lich_su_cong_viec
  --
  +id: INTEGER <<PK, NOT NULL>>
  +cong_viec_id: INTEGER <<FK, NOT NULL>>
  +trang_thai_cu: STRING(30)
  +trang_thai_moi: STRING(30)
  +thoi_gian_thay_doi: DATE
  --
  +{static} ghiNhan(congViec, trangThaiCu, trangThaiMoi): LichSuCongViec
  +xoa(): void
}

class Nhom <<entity>> {
  table: nhom
  --
  +id: INTEGER <<PK, NOT NULL>>
  +ten_nhom: STRING(100) <<NOT NULL>>
  +mo_ta: TEXT
  +truong_nhom_id: INTEGER <<FK, NOT NULL>>
  +ngay_tao: DATE
  --
  +{static} tao(thongTin): Nhom
  +capNhat(thongTin): void
  +moiThanhVien(nguoiDung): ThanhVienNhom
  +chuyenTruongNhom(thanhVien): void
  +xoa(): void
}

class ThanhVienNhom <<entity>> {
  table: thanh_vien_nhom
  --
  +id: INTEGER <<PK, NOT NULL>>
  +nhom_id: INTEGER <<FK, NOT NULL>>
  +nguoi_dung_id: INTEGER <<FK, NOT NULL>>
  +vai_tro: ENUM('TRUONG_NHOM', 'THANH_VIEN')
  +ngay_tham_gia: DATE
  --
  +roiNhom(): void
  +xoaKhoiNhom(): void
}

class PhienDangNhap <<entity>> {
  table: phien_dang_nhap
  --
  +token_hash: STRING(64) <<PK, NOT NULL>>
  +nguoi_dung_id: INTEGER <<FK, NOT NULL>>
  +het_han: DATE <<NOT NULL>>
  --
  +{static} tao(nguoiDung): PhienDangNhap
  +kiemTraHopLe(): Boolean
  +thuHoi(): void
}

class CongViecNhom <<entity>> {
  table: cong_viec_nhom
  --
  +id: INTEGER <<PK, NOT NULL>>
  +nhom_id: INTEGER <<FK, NOT NULL>>
  +nguoi_giao_id: INTEGER <<FK, NOT NULL>>
  +nguoi_nhan_id: INTEGER <<FK>>
  +tieu_de: STRING(200) <<NOT NULL>>
  +mo_ta: TEXT
  +muc_do_uu_tien: STRING(20)
  +trang_thai: STRING(20)
  +han_hoan_thanh: DATE
  +ngay_tao: DATE
  +ngay_cap_nhat: DATE
  +file_dinh_kem: TEXT
  --
  +{static} tao(thongTin): CongViecNhom
  +capNhat(thongTin): void
  +capNhatTrangThai(trangThai): void
  +xoa(): void
}

class BuocCongViec <<entity>> {
  table: buoc_cong_viec
  --
  +id: INTEGER <<PK, NOT NULL>>
  +cong_viec_id: INTEGER <<FK, NOT NULL>>
  +noi_dung: STRING(200) <<NOT NULL>>
  +hoan_thanh: BOOLEAN <<NOT NULL>>
  --
  +{static} tao(congViec, noiDung): BuocCongViec
  +capNhatNoiDung(noiDung): void
  +danhDauHoanThanh(hoanThanh): void
  +xoa(): void
}

class BinhLuanNhom <<entity>> {
  table: binh_luan_nhom
  --
  +id: INTEGER <<PK, NOT NULL>>
  +cong_viec_nhom_id: INTEGER <<FK, NOT NULL>>
  +nguoi_dung_id: INTEGER <<FK, NOT NULL>>
  +noi_dung: TEXT <<NOT NULL>>
  +ngay_tao: DATE <<NOT NULL>>
  --
  +{static} them(congViecNhom, tacGia, noiDung): BinhLuanNhom
  +xoa(): void
}

class NhatKyNhom <<entity>> {
  table: nhat_ky_nhom
  --
  +id: INTEGER <<PK, NOT NULL>>
  +nhom_id: INTEGER <<FK, NOT NULL>>
  +nguoi_dung_id: INTEGER <<FK, NOT NULL>>
  +cong_viec_nhom_id: INTEGER <<FK>>
  +hanh_dong: STRING(40) <<NOT NULL>>
  +noi_dung: TEXT <<NOT NULL>>
  +ngay_tao: DATE <<NOT NULL>>
  --
  +{static} ghiNhan(nhom, nguoiThucHien, hanhDong, noiDung): NhatKyNhom
  +{static} layTheoNhom(nhom): List<NhatKyNhom>
}

NguoiDung "1" -- "0..*" PhienDangNhap : nguoi_dung_id
NguoiDung "1" -- "0..*" DanhMuc : nguoiDung (nguoi_dung_id)
NguoiDung "1" -- "0..*" CongViec : nguoiDung (nguoi_dung_id)
DanhMuc "0..1" -- "0..*" CongViec : danhMuc (danh_muc_id)
CongViec "1" -- "0..*" NhacNho : congViec (cong_viec_id)
NguoiDung "1" -- "0..*" ThongBao : nguoiDung (nguoi_dung_id)
CongViec "0..1" -- "0..*" ThongBao : congViec (cong_viec_id)
CongViec "1" -- "0..*" LichSuCongViec : congViec (cong_viec_id)
Nhom "1" -- "0..*" ThanhVienNhom : nhom (nhom_id)
NguoiDung "1" -- "0..*" ThanhVienNhom : nguoiDung (nguoi_dung_id)
NguoiDung "1" -- "0..*" Nhom : truongNhom (truong_nhom_id)
Nhom "1" -- "0..*" CongViecNhom : nhom (nhom_id)
NguoiDung "1" -- "0..*" CongViecNhom : nguoiGiao (nguoi_giao_id)
NguoiDung "0..1" -- "0..*" CongViecNhom : nguoiNhan (nguoi_nhan_id)
CongViec "1" -- "0..*" BuocCongViec : cong_viec_id
CongViecNhom "1" -- "0..*" BinhLuanNhom : cong_viec_nhom_id
NguoiDung "1" -- "0..*" BinhLuanNhom : tacGia (nguoi_dung_id)
Nhom "1" -- "0..*" NhatKyNhom : nhom_id
NguoiDung "1" -- "0..*" NhatKyNhom : nguoiThucHien (nguoi_dung_id)
CongViecNhom "0..1" -- "0..*" NhatKyNhom : congViecNhom (cong_viec_nhom_id)
Nhom "0..1" -- "0..*" ThongBao : nhom_id
CongViecNhom "0..1" -- "0..*" ThongBao : cong_viec_nhom_id

note bottom of ThanhVienNhom
  UNIQUE(nhom_id, nguoi_dung_id)
end note

legend bottom
  Phương thức: đề xuất ở mức thiết kế nghiệp vụ, không phải method có sẵn trong Sequelize.
  Các thao tác hiện nằm ở API; phương thức BuocCongViec là đề xuất thiết kế.
  PK: khóa chính; FK: khóa ngoại.
  NOT NULL: bắt buộc; các thuộc tính còn lại có thể NULL.
  Quan hệ dựa trên models và khóa ngoại trong migrations.
  file_dinh_kem: TEXT chứa mảng URL dưới dạng JSON.
endlegend
@enduml
